---
import '../styles/tokens.css';
import '../styles/bundle.css';
import '../styles/global.css';
import { descricaoCurta, serializarJsonLd, urlAbsoluta } from '../lib/seo';
import type { PropsSeo } from '../lib/seo';

interface Props extends PropsSeo {
  /** Título da página. O nome da paróquia é acrescentado ao final (salvo `semSufixo`). */
  title: string;
  /** Descrição curta para buscadores e redes sociais (cortada em 160 caracteres). */
  description?: string;
}

const NOME_PAROQUIA = 'Paróquia Nossa Senhora do Rosário';
const DESCRICAO_PADRAO =
  'Horários de missa, liturgia do dia, agenda e pastorais da Paróquia Nossa Senhora do Rosário, em Jaguaribe, João Pessoa.';

const {
  title,
  description,
  semSufixo = false,
  noindex = false,
  jsonLd,
  tipoOg = 'website',
  imagem = '/og-padrao.png',
} = Astro.props;

const tituloCompleto = semSufixo ? title : `${title} · ${NOME_PAROQUIA}`;
const descricao = descricaoCurta(description) ?? DESCRICAO_PADRAO;

// Endereços absolutos (Open Graph e canônico exigem). `Astro.site` vem de SITE_URL.
const canonico = urlAbsoluta(Astro.url.pathname, Astro.site);
const imagemAbsoluta = urlAbsoluta(imagem, Astro.site);
const dadosEstruturados = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Estatísticas sem cookies (Cloudflare Web Analytics). Só entra se o token estiver definido;
// no Cloudflare Pages também dá para ligar no painel, sem código (ver docs/qualidade.md).
const tokenEstatisticas = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN?.trim();

// As mesmas famílias e pesos de design-system/components/bundle.css (que não
// carrega mais as fontes por @import, pois isso bloqueia a renderização).
// Ao terminar de baixar, o preload vira uma folha de estilo (um atributo só, sem script à parte).
const TROCA_PARA_FOLHA_DE_ESTILO = { onload: "this.onload=null;this.rel='stylesheet'" };

const FONTES =
  'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonico} />}

    <meta property="og:type" content={tipoOg} />
    <meta property="og:site_name" content={NOME_PAROQUIA} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={imagemAbsoluta} />
    {imagem === '/og-padrao.png' && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
          property="og:image:alt"
          content="Fachada da Igreja Nossa Senhora do Rosário, em Jaguaribe"
        />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- As fontes não bloqueiam a renderização: o texto aparece na fonte do sistema e troca (font-display: swap). -->
    <link rel="preload" as="style" href={FONTES} {...TROCA_PARA_FOLHA_DE_ESTILO} />
    <noscript>
      <link rel="stylesheet" href={FONTES} />
    </noscript>

    {dadosEstruturados.map((dados) => (
      <script type="application/ld+json" set:html={serializarJsonLd(dados)} />
    ))}
  </head>
  <body>
    <a class="pular" href="#conteudo">
      Pular para o conteúdo
    </a>
    <slot name="cabecalho" />
    <main id="conteudo">
      <slot />
    </main>
    <slot name="rodape" />
    {tokenEstatisticas && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: tokenEstatisticas })}
      />
    )}
  </body>
</html>
