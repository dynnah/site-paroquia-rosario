---
import '../styles/tokens.css';
import '../styles/bundle.css';
import '../styles/global.css';

interface Props {
  /** Título da página. O nome da paróquia é acrescentado ao final. */
  title: string;
  /** Descrição curta para buscadores e redes sociais. */
  description?: string;
}

const NOME_PAROQUIA = 'Paróquia Nossa Senhora do Rosário';

const {
  title,
  description = 'Horários de missa, liturgia do dia, agenda e pastorais da Paróquia Nossa Senhora do Rosário, em Jaguaribe, João Pessoa.',
} = Astro.props;

const tituloCompleto = `${title} · ${NOME_PAROQUIA}`;

// As mesmas famílias e pesos de design-system/components/bundle.css (que não
// carrega mais as fontes por @import, pois isso bloqueia a renderização).
const FONTES =
  'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTES} />
  </head>
  <body>
    <a class="pular" href="#conteudo">
      Pular para o conteúdo
    </a>
    <main id="conteudo">
      <slot />
    </main>
  </body>
</html>
