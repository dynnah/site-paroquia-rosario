---
/**
 * Layout das páginas do site: cabeçalho, conteúdo, rodapé e, se pedida,
 * a barra de atalhos do celular. Os dados da paróquia vêm do documento
 * `configuracoes` do Sanity (com os valores confirmados como reserva).
 * O /styleguide usa o BaseLayout direto.
 */
import BarraMobile from '../components/BarraMobile.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { LINKS_INSTITUCIONAIS, LINKS_PRINCIPAIS } from '../lib/navegacao';
import {
  dadosDaParoquia,
  enderecoEmLinhas,
  linksDeContatoDoRodape,
  urlInstagram,
  urlMapa,
  urlWhatsApp,
} from '../lib/paroquia';
import { conteudo } from '../lib/sanity';
import type { PropsSeo } from '../lib/seo';
import type { LinkSimples } from '../lib/tipos';
import BaseLayout from './BaseLayout.astro';

interface Props extends PropsSeo {
  title: string;
  description?: string;
  /** Barra fixa no celular: Horários · Como chegar · WhatsApp. */
  barraMobile?: boolean;
}

const { barraMobile = false, ...base } = Astro.props;

const paroquia = dadosDaParoquia(await conteudo.configuracoes());

const mapaHref = urlMapa(paroquia);
const whatsappHref = urlWhatsApp(paroquia.whatsapp);
const instagramHref = urlInstagram(paroquia.instagram);

const redes: LinkSimples[] = [];
if (instagramHref) redes.push({ rotulo: 'Instagram', href: instagramHref });
if (paroquia.youtube) redes.push({ rotulo: 'YouTube', href: paroquia.youtube });

// WhatsApp e ligação em links separados (o telefone da secretaria atende nos dois).
const contato: LinkSimples[] = linksDeContatoDoRodape(paroquia);
---

<BaseLayout {...base}>
  <Header
    slot="cabecalho"
    links={LINKS_PRINCIPAIS}
    caminhoAtual={Astro.url.pathname}
    nome={paroquia.nome}
  />

  <slot />

  <Fragment slot="rodape">
    <Footer
      nome={paroquia.nome}
      endereco={enderecoEmLinhas(paroquia)}
      mapaHref={mapaHref}
      navegacao={LINKS_PRINCIPAIS}
      institucional={LINKS_INSTITUCIONAIS}
      redes={redes}
      contato={contato}
    />
    {barraMobile && <BarraMobile mapaHref={mapaHref} whatsappHref={whatsappHref} />}
  </Fragment>
</BaseLayout>
