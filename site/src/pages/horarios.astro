---
import Botao from '../components/Botao.astro';
import CardHorarios from '../components/CardHorarios.astro';
import EstadoVazio from '../components/EstadoVazio.astro';
import PaginaInterna from '../layouts/PaginaInterna.astro';
import { dadosDaParoquia, urlMapa, urlWhatsApp } from '../lib/paroquia';
import { conteudo } from '../lib/sanity';

const [horarios, config] = await Promise.all([conteudo.horarios(), conteudo.configuracoes()]);
const paroquia = dadosDaParoquia(config);
const whatsapp = urlWhatsApp(paroquia.whatsapp);

const grupos = horarios
  ? [
      { chave: 'missa', titulo: 'Santa Missa', grupo: horarios.missa },
      { chave: 'confissao', titulo: 'Confissões', grupo: horarios.confissao },
      { chave: 'adoracao', titulo: 'Adoração', grupo: horarios.adoracao },
      { chave: 'rosario', titulo: 'Santo Rosário', grupo: horarios.rosario },
      { chave: 'secretaria', titulo: 'Secretaria', grupo: horarios.secretaria },
    ].filter(({ grupo }) => grupo.linhas.length > 0)
  : [];
---

<PaginaInterna
  title="Horários"
  description="Horários de missa, confissão, adoração, Santo Rosário e atendimento da secretaria da Paróquia Nossa Senhora do Rosário, em Jaguaribe, João Pessoa."
  titulo="Horários"
  intro="Missas, confissões, adoração, Santo Rosário e o atendimento da secretaria."
  barraMobile
>
  {grupos.length === 0 ? (
    <EstadoVazio
      titulo="Os horários estão sendo atualizados."
      texto="Fale com a secretaria para saber os horários desta semana."
      acao={{ rotulo: 'Como chegar', href: urlMapa(paroquia) }}
    />
  ) : (
    <>
      {/* Os cards têm título h3 (design system): este h2 só para leitor de tela mantém a ordem h1 → h2 → h3. */}
      <h2 class="sr-only">Horários por tipo</h2>
      <div class:list={['ros-horarios-grade', { 'ros-horarios-grade--painel': grupos.length === 5 }]}>
        {grupos.map(({ chave, titulo, grupo }) => (
          <div class="bloco" style={`--area: ${chave}`}>
            <CardHorarios titulo={titulo} linhas={grupo.linhas} />
          </div>
        ))}
      </div>
    </>
  )}

  <div class="acoes">
    <Botao href={urlMapa(paroquia)} icone="local">
      Como chegar
    </Botao>
    {whatsapp && (
      <Botao variante="secundario" href={whatsapp} icone="mensagem">
        Falar no WhatsApp
      </Botao>
    )}
  </div>
</PaginaInterna>

<style>
  /* O card cresce até a altura do bloco. Só faz efeito na grade de computador, onde os blocos de
     uma linha têm a mesma altura. */
  .bloco {
    display: flex;
    flex-direction: column;
    gap: var(--espaco-2);
  }

  .bloco > :global(.ros-horarios) {
    flex: 1;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3);
  }
</style>
