---
import Botao from '../../components/Botao.astro';
import TextoRico from '../../components/TextoRico.astro';
import ArtigoLayout from '../../layouts/ArtigoLayout.astro';
import { conteudo } from '../../lib/sanity';

export async function getStaticPaths() {
  const slugs = await conteudo.slugs('pastoral');
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const pastoral = await conteudo.pastoral(slug!);
if (!pastoral) throw new Error(`Pastoral não encontrada: ${slug}`);

const dados = [
  { rotulo: 'Encontros', valor: pastoral.encontros },
  { rotulo: 'Responsável', valor: pastoral.responsavel },
  { rotulo: 'Contato', valor: pastoral.contato },
].filter((dado): dado is { rotulo: string; valor: string } => Boolean(dado.valor));
---

<ArtigoLayout
  title={pastoral.nome}
  description={pastoral.descricao}
  voltar={{ rotulo: 'Pastorais', href: '/pastorais' }}
  titulo={pastoral.nome}
>
  <p slot="sobrelinha" class="ros-sobrelinha">
    {pastoral.categoria}
  </p>

  <p class="lead corpo-grande">{pastoral.descricao}</p>

  {dados.length > 0 && (
    <dl class="dados">
      {dados.map((dado) => (
        <div>
          <dt class="pequeno">{dado.rotulo}</dt>
          <dd>{dado.valor}</dd>
        </div>
      ))}
    </dl>
  )}

  {pastoral.sobre && (
    <div class="ros-artigo__texto">
      <TextoRico texto={pastoral.sobre} />
    </div>
  )}

  {pastoral.link && (
    <p class="acao">
      <Botao href={pastoral.link.href}>{pastoral.link.rotulo}</Botao>
    </p>
  )}
</ArtigoLayout>

<style>
  .lead {
    margin: var(--espaco-4) 0 0;
    color: var(--texto-suave);
  }

  .dados {
    display: grid;
    gap: var(--espaco-4);
    margin: var(--espaco-6) 0 0;
    padding: var(--espaco-6);
    background: var(--fundo-afundado);
    border-radius: var(--raio-m);
  }

  .dados dt {
    color: var(--texto-suave);
  }

  .dados dd {
    margin: 0;
    font-weight: 600;
  }

  .acao {
    margin: var(--espaco-8) 0 0;
  }
</style>
