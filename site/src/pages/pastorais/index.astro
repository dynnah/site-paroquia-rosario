---
import CardPastoral from '../../components/CardPastoral.astro';
import EstadoVazio from '../../components/EstadoVazio.astro';
import PaginaInterna from '../../layouts/PaginaInterna.astro';
import { propsCardPastoral } from '../../lib/pastorais';
import { conteudo } from '../../lib/sanity';

const pastorais = await conteudo.pastorais();
---

<PaginaInterna
  title="Pastorais e movimentos"
  description="Pastorais e movimentos da Paróquia Nossa Senhora do Rosário: encontros, como participar e quem coordena."
  titulo="Pastorais"
  destaque="e movimentos"
  intro="Há um lugar para cada um servir e crescer na fé. Veja quando se encontram e como participar."
>
  {pastorais.length === 0 ? (
    <EstadoVazio
      titulo="Estamos reunindo as informações das pastorais."
      texto="Enquanto isso, fale com a secretaria para saber como participar."
      acao={{ rotulo: 'Fale conosco', href: '/contato' }}
    />
  ) : (
    <>
      {/* Os cards têm título h3 (design system): este h2, só para leitor de tela, mantém a ordem h1 → h2 → h3. */}
      <h2 class="sr-only">Pastorais e movimentos</h2>
      <div class="ros-grade">
        {pastorais.map((pastoral) => (
          <CardPastoral {...propsCardPastoral(pastoral)} />
        ))}
      </div>
    </>
  )}
</PaginaInterna>
