---
/**
 * Início: o horário primeiro. Avisos ativos, hero com a próxima missa, resumo do
 * Evangelho de hoje, horários, próximos eventos, últimos posts, pastorais e doação.
 */
import Aviso from '../components/Aviso.astro';
import CardEvento from '../components/CardEvento.astro';
import CardHorarios from '../components/CardHorarios.astro';
import CardPastoral from '../components/CardPastoral.astro';
import CardPost from '../components/CardPost.astro';
import DivisorTerco from '../components/DivisorTerco.astro';
import DoacaoPix from '../components/DoacaoPix.astro';
import Hero from '../components/Hero.astro';
import LiturgiaResumo from '../components/LiturgiaResumo.astro';
import SecaoPagina from '../components/SecaoPagina.astro';
import PaginaLayout from '../layouts/PaginaLayout.astro';
import { propsCardPost } from '../lib/blog';
import { propsCardEvento } from '../lib/eventos';
import { dataISO } from '../lib/formatacao';
import { proximaMissa } from '../lib/horarios';
import { evangelhoDoDia, liturgiaDoDia } from '../lib/liturgia';
import { dadosDaParoquia, urlMapa } from '../lib/paroquia';
import { propsCardPastoral } from '../lib/pastorais';
import { conteudo } from '../lib/sanity';

const agora = new Date();
const [config, horarios, avisos, eventos, blog, pastorais, liturgia] = await Promise.all([
  conteudo.configuracoes(),
  conteudo.horarios(),
  conteudo.avisosAtivos(),
  conteudo.eventosProximos(3),
  conteudo.posts('tudo', 1, 3),
  conteudo.pastorais(),
  liturgiaDoDia(dataISO(agora)),
]);

const paroquia = dadosDaParoquia(config);
// Sem a API (ou sem Evangelho no dia, como na Vigília Pascal), o resumo simplesmente não aparece.
const evangelho = evangelhoDoDia(liturgia);
const missa = horarios?.missa.linhas ?? [];
const confissao = horarios?.confissao.linhas ?? [];
const adoracao = horarios?.adoracao.linhas ?? [];
const proxima = proximaMissa(missa, agora);

// TODO(paroquia): chave Pix oficial e nome do titular, no documento "Configurações" do Studio.
const pix =
  config?.pixChave && config.pixTitular
    ? { chave: config.pixChave, titular: config.pixTitular }
    : null;
---

<PaginaLayout
  title="Início"
  description="Horários de missa, liturgia do dia, agenda e pastorais da Paróquia Nossa Senhora do Rosário, em Jaguaribe, João Pessoa."
  barraMobile
>
  {avisos.length > 0 && (
    <div class="container avisos">
      {avisos.slice(0, 2).map((aviso) => (
        <Aviso tipo={aviso.tipo} titulo={aviso.titulo} texto={aviso.texto} link={aviso.link} />
      ))}
    </div>
  )}

  <Hero
    sobrelinha="Jaguaribe · João Pessoa"
    titulo="Nossa Senhora"
    tituloItalico="do Rosário"
    texto="Igreja neoclássica erguida pelos frades franciscanos entre 1927 e 1929. Venha rezar conosco."
    proximaMissa={proxima ?? undefined}
    linhasMissa={missa}
    acaoPrimaria={{ rotulo: 'Ver horários', href: '/horarios', icone: 'relogio' }}
    acaoSecundaria={{ rotulo: 'Como chegar', href: urlMapa(paroquia), icone: 'local' }}
  />

  {evangelho && (
    <div class="container resumo">
      <LiturgiaResumo href="/liturgia#ev-hoje" referencia={evangelho.referencia} />
    </div>
  )}

  {(missa.length > 0 || confissao.length > 0 || adoracao.length > 0) && (
    <SecaoPagina
      id="horarios"
      sobrelinha="Horários"
      titulo="Missas, confissões"
      destaque="e adoração"
      acao={{ rotulo: 'Ver todos os horários', href: '/horarios' }}
    >
      <div class="grade-horarios">
        {missa.length > 0 && <CardHorarios titulo="Santa Missa" linhas={missa} />}
        {confissao.length > 0 && <CardHorarios titulo="Confissões" linhas={confissao} />}
        {adoracao.length > 0 && <CardHorarios titulo="Adoração" linhas={adoracao} />}
      </div>
    </SecaoPagina>
  )}

  <div class="container divisor">
    <DivisorTerco />
  </div>

  {eventos.length > 0 && (
    <SecaoPagina
      id="agenda"
      sobrelinha="Agenda"
      titulo="Próximos"
      destaque="encontros"
      acao={{ rotulo: 'Ver agenda', href: '/agenda' }}
    >
      <div class="ros-grade">
        {eventos.map((evento) => (
          <CardEvento {...propsCardEvento(evento)} />
        ))}
      </div>
    </SecaoPagina>
  )}

  {blog.posts.length > 0 && (
    <SecaoPagina
      id="blog"
      sobrelinha="Blog"
      titulo="Palavra"
      destaque="da comunidade"
      acao={{ rotulo: 'Ver blog', href: '/blog' }}
      fundo="afundado"
    >
      <div class="ros-grade">
        {blog.posts.map((post) => (
          <CardPost {...propsCardPost(post)} />
        ))}
      </div>
    </SecaoPagina>
  )}

  {pastorais.length > 0 && (
    <SecaoPagina
      id="pastorais"
      sobrelinha="Pastorais e movimentos"
      titulo="Há um lugar"
      destaque="para você"
      acao={{ rotulo: 'Ver pastorais', href: '/pastorais' }}
    >
      <div class="ros-grade">
        {pastorais.slice(0, 3).map((pastoral) => (
          <CardPastoral {...propsCardPastoral(pastoral)} />
        ))}
      </div>
    </SecaoPagina>
  )}

  {pix && (
    <>
      <div class="container divisor">
        <DivisorTerco />
      </div>
      <section class="container doacao" aria-label="Dízimo e doações">
        <DoacaoPix chave={pix.chave} titular={pix.titular} />
      </section>
    </>
  )}
</PaginaLayout>

<style>
  .avisos {
    display: grid;
    gap: var(--espaco-3);
    padding-top: var(--espaco-4);
  }

  .resumo {
    padding-top: var(--espaco-6);
  }

  /* o cartão não vira uma faixa de 1200px no desktop; o container segue alinhado ao resto */
  .resumo :global(.ros-liturgia-resumo) {
    max-width: var(--medida-texto);
  }

  .divisor {
    padding-block: var(--espaco-4);
  }

  .doacao {
    padding-block: var(--espaco-8) var(--espaco-12);
  }

  @media (min-width: 1024px) {
    .doacao {
      padding-block: var(--espaco-8) var(--espaco-16);
    }
  }
</style>
