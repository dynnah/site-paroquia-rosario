---
import Aviso from '../../components/Aviso.astro';
import Botao from '../../components/Botao.astro';
import TextoRico from '../../components/TextoRico.astro';
import ArtigoLayout from '../../layouts/ArtigoLayout.astro';
import { jaAconteceu, quandoAcontece, separarDestaque } from '../../lib/eventos';
import { dadosDaParoquia } from '../../lib/paroquia';
import { conteudo } from '../../lib/sanity';
import { jsonLdEvento, urlAbsoluta } from '../../lib/seo';

// Inclui eventos que já passaram: o endereço continua valendo para quem guardou o link.
export async function getStaticPaths() {
  const slugs = await conteudo.slugs('evento');
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const evento = await conteudo.evento(slug!);
if (!evento) throw new Error(`Evento não encontrado: ${slug}`);

const paroquia = dadosDaParoquia(await conteudo.configuracoes());
const jsonLd = jsonLdEvento(evento, paroquia, {
  url: urlAbsoluta(Astro.url.pathname, Astro.site),
  imagem: urlAbsoluta('/og-padrao.png', Astro.site),
  site: urlAbsoluta('/', Astro.site),
});

const quando = quandoAcontece(evento);
const { titulo, destaque } = separarDestaque(evento.titulo, evento.destaque);
const passou = jaAconteceu(evento);
---

<ArtigoLayout
  title={evento.titulo}
  description={`${quando}${evento.local ? ` · ${evento.local}` : ''}`}
  jsonLd={jsonLd}
  voltar={{ rotulo: 'Agenda', href: '/agenda' }}
  titulo={titulo}
  destaque={destaque}
>
  <p slot="sobrelinha" class="ros-sobrelinha">
    {quando}
  </p>

  {evento.local && (
    <p class="ros-artigo__autor">
      <b>{evento.local}</b>
    </p>
  )}

  {passou && (
    <div class="aviso">
      <Aviso
        titulo="Este evento já aconteceu."
        texto="Veja o que vem pela frente na agenda."
        link={{ rotulo: 'Ver agenda', href: '/agenda' }}
      />
    </div>
  )}

  {evento.descricao && (
    <div class="ros-artigo__texto">
      <TextoRico texto={evento.descricao} />
    </div>
  )}

  {!passou && evento.inscricaoUrl && (
    <p class="acao">
      <Botao href={evento.inscricaoUrl}>Quero participar</Botao>
    </p>
  )}
</ArtigoLayout>

<style>
  .aviso {
    margin-top: var(--espaco-6);
  }

  .acao {
    margin: var(--espaco-8) 0 0;
  }
</style>
