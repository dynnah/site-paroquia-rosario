---
/**
 * Liturgia (composição "Página Liturgia"): leituras à esquerda, santo do dia e
 * missa de hoje à direita; no celular, nessa ordem, em uma coluna.
 * TODO(fase 5): as leituras do dia (API, tempo litúrgico, navegação de datas) entram
 * no lugar de `LiturgiaIndisponivel`; até lá a página mostra a data e o link oficial.
 */
import CardHorarios from '../components/CardHorarios.astro';
import LiturgiaIndisponivel from '../components/LiturgiaIndisponivel.astro';
import SantoDoDia from '../components/SantoDoDia.astro';
import PaginaLayout from '../layouts/PaginaLayout.astro';
import { linhasDeHoje } from '../lib/horarios';
import { conteudo } from '../lib/sanity';

const agora = new Date();
const [horarios, santos] = await Promise.all([conteudo.horarios(), conteudo.santosDoDia(agora)]);

const santo = santos[0];
const missaHoje = horarios ? linhasDeHoje(horarios.missa.linhas, agora) : [];

const GRAU = { memoria: 'Memória', festa: 'Festa', solenidade: 'Solenidade' } as const;
const FAMILIA = { franciscana: 'franciscana', mariana: 'mariana', nenhuma: undefined } as const;
---

<PaginaLayout
  title="Liturgia"
  description="Leituras do dia, santo do dia e missa de hoje na Paróquia Nossa Senhora do Rosário, em Jaguaribe, João Pessoa."
>
  <div class="ros-pagina">
    <div class="ros-pagina__in">
      <div class="ros-pagina__cab">
        <h1 class="ros-pagina__titulo">Liturgia</h1>
      </div>

      <div>
        <LiturgiaIndisponivel data={agora} />
      </div>

      <aside class="ros-pagina__lateral" aria-label="Santo do dia e missa de hoje">
        {santo && (
          <SantoDoDia
            nome={santo.nome}
            destaque={santo.destaque}
            grau={GRAU[santo.grau]}
            familia={FAMILIA[santo.familia]}
            datas={santo.datasDeVida}
            bio={santo.bio}
          />
        )}
        {missaHoje.length > 0 && <CardHorarios titulo="Missa de hoje" linhas={missaHoje} />}
      </aside>
    </div>
  </div>
</PaginaLayout>
