---
import Botao from '../../components/Botao.astro';
import TextoRico from '../../components/TextoRico.astro';
import ArtigoLayout from '../../layouts/ArtigoLayout.astro';
import { descreverTurma } from '../../lib/sacramentos';
import { conteudo } from '../../lib/sanity';

export async function getStaticPaths() {
  const slugs = await conteudo.slugs('sacramento');
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const sacramento = await conteudo.sacramento(slug!);
if (!sacramento) throw new Error(`Sacramento não encontrado: ${slug}`);
---

<ArtigoLayout
  title={sacramento.nome}
  description={sacramento.resumo}
  voltar={{ rotulo: 'Sacramentos', href: '/sacramentos' }}
  titulo={sacramento.nome}
>
  <p slot="sobrelinha" class="ros-sobrelinha">
    Sacramento
  </p>

  <p class="lead corpo-grande">{sacramento.resumo}</p>

  {sacramento.requisitos.length > 0 && (
    <>
      <h2 class="ros-artigo__subtitulo">Requisitos</h2>
      <div class="ros-artigo__texto ros-artigo__texto--compacto">
        <ul>
          {sacramento.requisitos.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </>
  )}

  {sacramento.documentos.length > 0 && (
    <>
      <h2 class="ros-artigo__subtitulo">Documentos</h2>
      <div class="ros-artigo__texto ros-artigo__texto--compacto">
        <ul>
          {sacramento.documentos.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </>
  )}

  {sacramento.proximasTurmas.length > 0 && (
    <>
      <h2 class="ros-artigo__subtitulo">Próximas turmas</h2>
      <ul class="turmas">
        {sacramento.proximasTurmas.map((turma) => (
          <li class="turma">
            <div>
              <strong>{turma.nome}</strong>
              <span class="pequeno">{descreverTurma(turma)}</span>
            </div>
            {turma.inscricaoUrl && (
              <Botao variante="secundario" href={turma.inscricaoUrl}>
                Quero participar
              </Botao>
            )}
          </li>
        ))}
      </ul>
    </>
  )}

  {sacramento.sobre && (
    <div class="ros-artigo__texto">
      <TextoRico texto={sacramento.sobre} />
    </div>
  )}

  {sacramento.contato && (
    <p class="contato">
      <b>Contato</b>
      {sacramento.contato}
    </p>
  )}
</ArtigoLayout>

<style>
  .lead {
    margin: var(--espaco-4) 0 0;
    color: var(--texto-suave);
  }

  .turmas {
    display: grid;
    gap: var(--espaco-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .turma {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espaco-3) var(--espaco-6);
    padding: var(--espaco-4) var(--espaco-6);
    background: var(--fundo-afundado);
    border-radius: var(--raio-m);
  }

  .turma > div {
    display: grid;
    gap: var(--espaco-1);
  }

  .turma span {
    color: var(--texto-suave);
  }

  .contato {
    display: grid;
    gap: var(--espaco-1);
    margin: var(--espaco-8) 0 0;
    padding-top: var(--espaco-6);
    border-top: 1px solid var(--linha);
  }

  .contato b {
    font-weight: 600;
  }
</style>
