---
/** Mensagem acolhedora quando uma lista ainda não tem nada para mostrar. */
import type { LinkSimples } from '../lib/tipos';
import Botao from './Botao.astro';

interface Props {
  titulo: string;
  texto?: string;
  acao?: LinkSimples;
}

const { titulo, texto, acao } = Astro.props;
---

<div class="ros-vazio">
  <p class="ros-vazio__titulo">{titulo}</p>
  {texto && <p class="ros-vazio__texto">{texto}</p>}
  {acao && (
    <Botao variante="secundario" href={acao.href}>
      {acao.rotulo}
    </Botao>
  )}
</div>
