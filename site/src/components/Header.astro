---
import { Image } from 'astro:assets';
import logo from '../assets/logo-fachada-transparente.png';
import { estaAtivo } from '../lib/navegacao';
import type { LinkSimples } from '../lib/tipos';
import Botao from './Botao.astro';
import MenuGaveta from './MenuGaveta.vue';

interface Props {
  links: LinkSimples[];
  /** Caminho da página atual (ex.: Astro.url.pathname), para marcar o link ativo. */
  caminhoAtual?: string;
  horariosHref?: string;
  /** Cabeçalho fixo no topo ao rolar. */
  fixo?: boolean;
  /** Nome ao lado do logo. */
  nome?: string;
  /** Linha de baixo, opcional. O cabeçalho do site mostra só o nome da paróquia. */
  assinatura?: string;
}

const {
  links,
  caminhoAtual = '',
  horariosHref = '/horarios',
  fixo = true,
  nome = 'Paróquia Nossa Senhora do Rosário',
  assinatura,
} = Astro.props;

const itens = links.map((link) => ({ ...link, atual: estaAtivo(link.href, caminhoAtual) }));
---

<header class:list={['ros-header', { 'ros-header--fixo': fixo }]}>
  <div class="ros-header__in">
    <a class="ros-marca" href="/">
      <Image src={logo} alt="" width={48} height={48} densities={[1, 2]} loading="eager" />
      <span>
        <span class="ros-marca__nome">{nome}</span>
        {assinatura && <span class="ros-marca__sub">{assinatura}</span>}
      </span>
    </a>
    <nav class="ros-nav" aria-label="Principal">
      {itens.map((item) => (
        <a href={item.href} aria-current={item.atual ? 'page' : undefined}>
          {item.rotulo}
        </a>
      ))}
    </nav>
    <Botao href={horariosHref} icone="relogio">
      <span class="ros-header__horarios">Horários</span>
    </Botao>
    <MenuGaveta client:visible links={itens} />
  </div>
</header>
