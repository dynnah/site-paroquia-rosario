---
import { Image } from 'astro:assets';
import logo from '../assets/logo-fachada-transparente.png';
import type { NomeIcone } from '../lib/icones';
import Botao from './Botao.astro';
import Icone from './Icone.astro';

interface Acao {
  rotulo: string;
  href: string;
  icone?: NomeIcone;
}

interface Props {
  /** Ex.: "Jaguaribe · João Pessoa". */
  sobrelinha?: string;
  /** Primeira linha do título (romano): "Nossa Senhora". */
  titulo: string;
  /** Segunda linha (itálico, cor mariano): "do Rosário". */
  tituloItalico?: string;
  texto?: string;
  /** Calculada a partir da tabela de horários. Ex.: { quando: "hoje", hora: "17h" } ou { quando: "amanhã", hora: "7h" }. */
  proximaMissa?: { quando: string; hora: string; local?: string };
  /**
   * A tabela de missas (só `dias`, `horas` e `nota`, que diz o local). Com ela, o navegador
   * recalcula a "Próxima missa" na hora da visita, no fuso de São Paulo: a página é estática e
   * pode ter sido gerada horas antes (ou ficado em cache).
   */
  linhasMissa?: Array<{ dias: number[]; horas: string[]; nota?: string }>;
  /** Uma ação primária (Ver horários) e no máximo uma secundária. */
  acaoPrimaria?: Acao;
  acaoSecundaria?: Acao;
  /** Foto na moldura em arco (a fachada ou o altar, com boa luz). Sem foto, usa o logo. */
  foto?: { src: string; alt: string };
}

const {
  sobrelinha,
  titulo,
  tituloItalico,
  texto,
  proximaMissa,
  linhasMissa,
  acaoPrimaria,
  acaoSecundaria,
  foto,
} = Astro.props;

const linhasParaOScript = linhasMissa?.map(({ dias, horas, nota }) => ({ dias, horas, nota }));
---

<section class="ros-hero">
  <!-- Desenho de fundo: dois arcos grandes e uma colina suave. Só enfeite, fora da leitura. -->
  <div class="fundo" aria-hidden="true">
    <span class="fundo__arco fundo__arco--esq"></span>
    <span class="fundo__arco fundo__arco--dir"></span>
    <svg class="fundo__colina" viewBox="0 0 1440 64" preserveAspectRatio="none" focusable="false">
      <path d="M0 26C90 12 220 4 360 12C700 32 1060 54 1440 24V64H0Z"></path>
    </svg>
  </div>
  <div class="ros-hero__in">
    <div>
      {sobrelinha && <p class="ros-sobrelinha">{sobrelinha}</p>}
      <h1 class="ros-hero__titulo">
        {titulo}
        {tituloItalico && (
          <>
            {' '}
            <em>{tituloItalico}</em>
          </>
        )}
      </h1>
      {texto && <p class="ros-hero__texto">{texto}</p>}
      {proximaMissa && (
        <div
          class="ros-hero__proxima"
          data-proxima-missa={linhasParaOScript ? JSON.stringify(linhasParaOScript) : undefined}
        >
          <Icone nome="relogio" />
          <div>
            <span>
              Próxima missa · {proximaMissa.quando}
              {proximaMissa.local && ` · ${proximaMissa.local}`}
            </span>
            <br />
            <strong>{proximaMissa.hora}</strong>
          </div>
        </div>
      )}
      {(acaoPrimaria || acaoSecundaria) && (
        <div class="ros-hero__acoes">
          {acaoPrimaria && (
            <Botao href={acaoPrimaria.href} icone={acaoPrimaria.icone}>
              {acaoPrimaria.rotulo}
            </Botao>
          )}
          {acaoSecundaria && (
            <Botao variante="secundario" href={acaoSecundaria.href} icone={acaoSecundaria.icone}>
              {acaoSecundaria.rotulo}
            </Botao>
          )}
        </div>
      )}
    </div>
    <div class:list={['ros-arco', { 'ros-arco--foto': foto }]}>
      {foto ? (
        <img src={foto.src} alt={foto.alt} loading="lazy" decoding="async" />
      ) : (
        <Image
          src={logo}
          alt="Fachada da Igreja do Rosário"
          widths={[240, 447]}
          sizes="(min-width: 1400px) min(23.5vw, 473px), (min-width: 900px) 340px, 252px"
          loading="lazy"
        />
      )}
    </div>
  </div>
</section>

<script>
  // O site é estático: refaz a conta da "Próxima missa" na hora da visita, no fuso de São Paulo.
  import { proximaMissa } from '../lib/horarios';
  import type { LinhaHorario } from '../lib/sanity.tipos';

  function atualizarProximaMissa() {
    document.querySelectorAll<HTMLElement>('[data-proxima-missa]').forEach((bloco) => {
      let linhas: LinhaHorario[];
      try {
        // Só `dias`, `horas` e `nota` (o local) vêm na página: é o que o cálculo usa.
        linhas = JSON.parse(bloco.dataset.proximaMissa ?? '[]') as LinhaHorario[];
      } catch {
        return;
      }

      const rotulo = bloco.querySelector('span');
      const hora = bloco.querySelector('strong');
      if (!rotulo || !hora) return;

      const proxima = proximaMissa(linhas, new Date());
      // `hidden` perderia para o `display: flex` do bloco.
      bloco.style.display = proxima ? '' : 'none';
      if (!proxima) return;

      rotulo.textContent = `Próxima missa · ${proxima.quando}${proxima.local ? ` · ${proxima.local}` : ''}`;
      hora.textContent = proxima.hora;
    });
  }

  atualizarProximaMissa();
  // aba aberta de um horário para o outro
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) atualizarProximaMissa();
  });
</script>

<style>
  /* o ícone é um componente filho: o seletor precisa ser global */
  .ros-hero__proxima :global(svg) {
    width: 28px;
    height: 28px;
    color: var(--mariano);
    flex: none;
  }

  /* ── Desenho "Arco com a fachada" ─────────────────────────────────────────────────────────────
     Fundo claro com dois arcos grandes e uma colina suave; a fachada fica num arco com contorno
     fino dourado e um círculo de luz atrás, e a base dela é cortada pela borda do hero. Só usa as
     cores e medidas do design system; os tons dos arcos saem de misturas deles. */
  .ros-hero {
    position: relative;
    overflow: hidden;
    background: var(--fundo);
    --deco: color-mix(in srgb, var(--linha) 65%, var(--fundo));
  }

  .ros-hero__in {
    position: relative;
    z-index: 1;
  }

  .fundo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fundo__colina {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: block;
    width: 100%;
    /* cresce com a largura do hero (cqw): em telas grandes o desenho mantém a proporção */
    height: clamp(var(--espaco-16), 4.4cqw, 110px);
    fill: var(--fundo-afundado);
  }

  .fundo__arco {
    display: none;
    position: absolute;
    top: var(--espaco-8);
    bottom: 0;
    box-sizing: border-box;
    width: clamp(calc(var(--espaco-16) * 4), 17.8cqw, 400px);
    border: var(--espaco-6) solid var(--deco);
    border-bottom: 0;
    border-radius: var(--raio-arco) var(--raio-arco) 0 0;
  }

  /* Sobrelinha com um fio dourado depois do texto. O fio só ocupa o que sobra da linha (até 200px),
     então o texto nunca quebra por causa dele. */
  .ros-hero__in .ros-sobrelinha {
    display: flex;
    align-items: center;
    gap: var(--espaco-4);
  }

  .ros-hero__in .ros-sobrelinha::after {
    content: '';
    flex: 1 1 0;
    min-width: 0;
    max-width: 200px;
    height: 1px;
    background: var(--ouro);
  }

  .ros-hero__proxima {
    box-shadow: var(--sombra-card);
  }

  /* O arco: preenchimento ouro suave, contorno fino dourado um pouco fora e o círculo de luz. */
  .ros-arco {
    position: relative;
    overflow: visible;
    align-items: end;
    border: 0;
    background: var(--ouro-suave);
    border-radius: var(--raio-arco) var(--raio-arco) 0 0;
  }

  .ros-arco::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--espaco-2)) calc(-1 * var(--espaco-2)) 0;
    border: 1.5px solid var(--ouro);
    border-bottom: 0;
    border-radius: var(--raio-arco) var(--raio-arco) 0 0;
    pointer-events: none;
  }

  .ros-arco::after {
    content: '';
    position: absolute;
    top: 12%;
    left: 50%;
    width: 72%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ouro-suave) 45%, var(--fundo-elevado));
  }

  .ros-arco :global(img) {
    position: relative;
    z-index: 1;
    /* a imagem é quadrada e o desenho ocupa 88% da largura dela */
    width: 90%;
    height: auto;
  }

  @container (min-width: 900px) {
    .ros-hero__in {
      align-items: stretch;
      padding-bottom: var(--espaco-12);
    }

    /* O arco acompanha a altura do hero e desce até passar da borda dele, que corta a base. Ele e a
       fachada crescem com a largura da tela (23,5% dela, como no desenho de 1440px), até o limite
       da coluna: em 1440px ou menos o tamanho é o de sempre, 340px. */
    .ros-arco {
      align-self: stretch;
      aspect-ratio: auto;
      max-width: clamp(340px, 23.5cqw, 560px);
      margin-bottom: calc(-1 * (var(--espaco-12) + var(--espaco-6)));
    }

    /* O hero também cresce com a tela (36% da largura, como no desenho), e o texto fica no meio. */
    .ros-hero__in {
      min-height: min(36cqw, 760px);
    }

    .ros-hero__in > :first-child {
      align-self: center;
    }

    /* No computador a fachada preenche o arco (o desenho fica com 88% da largura dele). */
    .ros-arco :global(img) {
      width: 100%;
    }

    .ros-arco::after {
      top: 6%;
    }

    .fundo__arco--dir {
      display: block;
      top: var(--espaco-4);
      right: calc(-1 * var(--espaco-12));
      width: clamp(calc(var(--espaco-16) * 4.5), 20cqw, 450px);
    }
  }

  @container (min-width: 1100px) {
    .ros-hero__titulo {
      font-size: 64px;
      line-height: 68px;
    }
  }

  /* Só com sobra de tela dos dois lados: o arco da esquerda fica logo antes do texto, que alinha
     com o container do site. Em telas menores ele ficaria atrás do título. */
  @container (min-width: 1280px) {
    .fundo__arco--esq {
      display: block;
      right: calc(
        100% - (max(0px, (100% - var(--container-max)) / 2) + var(--espaco-8) - var(--espaco-6))
      );
    }
  }
</style>
