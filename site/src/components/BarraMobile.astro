---
import Icone from './Icone.astro';

interface Props {
  horariosHref?: string;
  /** "Como chegar" (veja urlMapa em lib/paroquia.ts). */
  mapaHref: string;
  /** Sem WhatsApp cadastrado, o atalho some. */
  whatsappHref?: string;
  /** Fixa no rodapé da tela (só abaixo de 1024px). Desligada, vira um bloco comum. */
  fixa?: boolean;
}

const { horariosHref = '/horarios', mapaHref, whatsappHref, fixa = true } = Astro.props;
---

<nav class:list={['ros-barra', { 'ros-barra--fixa': fixa }]} aria-label="Atalhos">
  <ul>
    <li>
      <a href={horariosHref}>
        <Icone nome="relogio" />
        <span>Horários</span>
      </a>
    </li>
    <li>
      <a href={mapaHref}>
        <Icone nome="local" />
        <span>Como chegar</span>
      </a>
    </li>
    {whatsappHref && (
      <li>
        <a href={whatsappHref}>
          <Icone nome="mensagem" />
          <span>WhatsApp</span>
        </a>
      </li>
    )}
  </ul>
</nav>
{fixa && <div class="ros-barra-espaco" aria-hidden="true"></div>}
