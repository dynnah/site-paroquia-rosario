---
import { Image } from 'astro:assets';
import logo from '../assets/logo-fachada-transparente.png';
import { partesData } from '../lib/formatacao';
import type { LinkSimples } from '../lib/tipos';

interface Props {
  /** Nome ao lado do logo. */
  nome: string;
  /** Linha de baixo, opcional. O rodapé do site mostra só o nome da paróquia. */
  assinatura?: string;
  /** [rua, "bairro · cidade – UF"] (veja enderecoEmLinhas em lib/paroquia.ts). */
  endereco: [string, string];
  mapaHref: string;
  navegacao: LinkSimples[];
  institucional: LinkSimples[];
  /** Instagram, YouTube… Só entram os que a paróquia tem. */
  redes?: LinkSimples[];
  /** Telefone, WhatsApp, e-mail… Só entram os que a paróquia tem. */
  contato?: LinkSimples[];
  /** Prefixo dos ids dos títulos; mude se houver dois rodapés na mesma página. */
  idBase?: string;
}

const {
  nome,
  assinatura,
  endereco,
  mapaHref,
  navegacao,
  institucional,
  redes = [],
  contato = [],
  idBase = 'rodape',
} = Astro.props;

const ano = partesData().ano;
const externo = (href: string) => /^https?:\/\//.test(href);
---

<footer class="ros-rodape">
  <div class="container ros-rodape__grade">
    <div class="ros-rodape__marca">
      <a class="ros-rodape__marca-link" href="/">
        <Image src={logo} alt="" width={48} height={48} densities={[1, 2]} loading="lazy" />
        <span>
          <span class="ros-rodape__nome">{nome}</span>
          {assinatura && <span class="ros-rodape__sub">{assinatura}</span>}
        </span>
      </a>
      <address>
        {endereco[0]}
        <br />
        {endereco[1]}
      </address>
      <a
        class="ros-rodape__como-chegar"
        href={mapaHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Como chegar (abre em outra aba)"
      >
        Como chegar
      </a>
    </div>

    <nav aria-labelledby={`${idBase}-navegue`}>
      <h2 class="ros-rodape__titulo" id={`${idBase}-navegue`}>
        Navegue
      </h2>
      <ul>
        {navegacao.map((link) => (
          <li>
            <a href={link.href}>{link.rotulo}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby={`${idBase}-paroquia`}>
      <h2 class="ros-rodape__titulo" id={`${idBase}-paroquia`}>
        A paróquia
      </h2>
      <ul>
        {institucional.map((link) => (
          <li>
            <a href={link.href}>{link.rotulo}</a>
          </li>
        ))}
      </ul>
    </nav>

    {(redes.length > 0 || contato.length > 0) && (
      <div>
        <h2 class="ros-rodape__titulo">Fale com a gente</h2>
        <ul>
          {contato.map((link) => (
            <li>
              <a href={link.href} rel={externo(link.href) ? 'noopener noreferrer' : undefined}>
                {link.rotulo}
              </a>
            </li>
          ))}
          {redes.map((link) => (
            <li>
              <a href={link.href} rel="noopener noreferrer">
                {link.rotulo}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="ros-rodape__base">
    <div class="container">
      <p>
        © {ano} {nome}.
      </p>
    </div>
  </div>
</footer>
