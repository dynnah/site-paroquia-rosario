---
interface Props {
  /** "Santa Isabel" + `destaque` "da Hungria". */
  nome: string;
  destaque?: string;
  grau?: 'Memória' | 'Festa' | 'Solenidade';
  /** "mártires", "bispo, doutor da Igreja". Vem do feed automático; o Studio usa `grau`. */
  funcao?: string;
  /** franciscana: cor terracota. mariana: cor mariano. Sem família, sem cor. */
  familia?: 'franciscana' | 'mariana';
  /** "1207–1231" */
  datas?: string;
  /** Duas ou três frases. Sem bio, o card mostra só o nome e os metadados. */
  bio?: string;
  /** Página com a história completa. */
  href?: string;
  /** Os outros santos do dia (só nomes), em "Também hoje". */
  outros?: string[];
  /** De onde vêm o santo e a bio, quando não foram escritos pela paróquia. */
  fonte?: { rotulo: string; href: string };
}

const { nome, destaque, grau, funcao, familia, datas, bio, href, outros = [], fonte } = Astro.props;

const rotuloFamilia = familia === 'franciscana' ? 'Família franciscana' : 'Família mariana';

type ItemMeta = { texto: string; classe?: string };
const meta = [
  grau ? { texto: grau } : undefined,
  funcao ? { texto: funcao.charAt(0).toUpperCase() + funcao.slice(1) } : undefined,
  familia ? { texto: rotuloFamilia, classe: 'ros-santo__familia' } : undefined,
  datas ? { texto: datas, classe: 'ros-santo__datas' } : undefined,
].filter((item): item is ItemMeta => item !== undefined);
---

<article class:list={['ros-santo', { 'ros-santo--mariano': familia === 'mariana' }]}>
  <p class="ros-santo__rotulo">Santo do dia</p>
  <h3 class="ros-santo__nome">
    {nome}
    {destaque && (
      <>
        {' '}
        <em>{destaque}</em>
      </>
    )}
  </h3>
  {meta.length > 0 && (
    <p class="ros-santo__meta">
      {meta.map((item, indice) => (
        <>
          {indice > 0 && ' · '}
          {item.classe ? <span class={item.classe}>{item.texto}</span> : item.texto}
        </>
      ))}
    </p>
  )}
  {bio && <p class="ros-santo__bio">{bio}</p>}
  {href && (
    <a class="ros-santo__link" href={href}>
      Ler a história
    </a>
  )}
  {outros.length > 0 && (
    <p class="ros-santo__outros pequeno">
      <strong>Também hoje:</strong> {outros.join(', ')}.
    </p>
  )}
  {fonte && (
    <p class="ros-santo__fonte">
      Fonte: <a href={fonte.href}>{fonte.rotulo}</a>
    </p>
  )}
</article>
