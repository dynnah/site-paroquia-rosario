---
/**
 * Reserva da liturgia: a data e o caminho para ler as leituras na fonte
 * oficial. É o que a página mostra quando a busca das leituras falha ou o dia
 * não tem leituras.
 */
import { dataLonga } from '../lib/formatacao';
import { LITURGIA_OFICIAL } from '../lib/liturgia';
import Botao from './Botao.astro';

interface Props {
  data?: string | Date;
}

const { data } = Astro.props;
---

<article class="ros-liturgia" aria-labelledby="lt-reserva">
  <p class="ros-liturgia__data">{dataLonga(data)}</p>
  <h2 class="ros-liturgia__titulo" id="lt-reserva">
    Leituras do dia
  </h2>
  <p class="ros-liturgia__reserva corpo">
    As leituras e o Evangelho deste dia estão na Liturgia Diária da CNBB. Leia antes da missa, em
    casa ou a caminho da igreja.
  </p>
  <Botao href={LITURGIA_OFICIAL.href} icone="livro">
    Ler na {LITURGIA_OFICIAL.rotulo}
  </Botao>
</article>
