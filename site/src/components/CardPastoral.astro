---
import type { FamiliaPastoral, LinkSimples } from '../lib/tipos';
import Botao from './Botao.astro';

interface Props {
  /** Define a cor do filete: paroquial (padrão), mariano, franciscano ou social. */
  familia?: FamiliaPastoral;
  /**
   * Cor do filete na página Nossa Comunidade (vale mais que `familia`): `pastoral` é o marrom
   * escuro; `movimento` (movimentos, grupos, ministérios e projetos) é um marrom mais claro.
   */
  tom?: 'pastoral' | 'movimento';
  /** Sobrelinha: "Movimento", "Ação social", "Formação". Sem ela, o card não mostra sobrelinha. */
  categoria?: string;
  nome: string;
  /** Uma frase do que a pastoral faz (opcional). */
  descricao?: string;
  /** Quando se reúne, como entrar, contato. */
  info?: { rotulo: string; valor: string }[];
  acao: LinkSimples;
}

const { familia = 'paroquial', tom, categoria, nome, descricao, info = [], acao } = Astro.props;
---

<article
  class:list={[
    'ros-pastoral',
    { [`ros-pastoral--${familia}`]: familia !== 'paroquial' },
    { [`ros-pastoral--${tom}`]: tom },
  ]}
>
  <div class="ros-pastoral__faixa"></div>
  <div class="ros-pastoral__corpo">
    {categoria && <p class="ros-sobrelinha">{categoria}</p>}
    <h3>{nome}</h3>
    {descricao && <p>{descricao}</p>}
    {info.length > 0 && (
      <ul class="ros-pastoral__info">
        {info.map((item) => (
          <li>
            <b>{item.rotulo}:</b> {item.valor}
          </li>
        ))}
      </ul>
    )}
    <Botao variante="secundario" href={acao.href}>
      {acao.rotulo}
    </Botao>
  </div>
</article>
