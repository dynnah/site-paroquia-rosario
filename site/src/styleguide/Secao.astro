---
interface Props {
  id: string;
  titulo: string;
  /** Origem no design system, ex.: "components/Botao". */
  origem?: string;
}

const { id, titulo, origem } = Astro.props;
---

<section class="container secao" id={id} aria-labelledby={`${id}-titulo`}>
  <h2 class="titulo-2" id={`${id}-titulo`}>
    {titulo}
  </h2>
  {origem && (
    <p class="pequeno origem">
      <code>{origem}</code>
    </p>
  )}
  <slot />
</section>

<style>
  .secao {
    padding-block: var(--espaco-8) 0;
  }

  .origem {
    margin: var(--espaco-1) 0 var(--espaco-4);
    color: var(--texto-suave);
  }
</style>
