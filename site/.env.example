# Copie para site/.env (nunca commite o .env).
# As variáveis PUBLIC_ vão para o navegador: não coloque segredo nelas.

# ID e dataset do projeto no Sanity (https://www.sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Opcional: token de leitura, só se o dataset passar a ser privado.
# Fica só no build (sem prefixo PUBLIC_), nunca no navegador.
SANITY_API_READ_TOKEN=

# Liturgia: o site publica o texto integral das leituras (tradução CNBB), dentro da
# própria página, sem configurar nada. Esta variável é só a válvula de segurança:
# com "true", o site passa a mostrar apenas as referências (veja docs/liturgia.md).
# LITURGIA_OCULTAR_TEXTO=true

# Endereço final do site, com https:// e sem barra no fim. Vira o endereço canônico, o
# Open Graph, o sitemap.xml e o robots.txt. Sem ele, o build usa http://localhost:4321.
# TODO(paroquia): preencher quando o domínio .org.br for registrado.
SITE_URL=

# Estatísticas sem cookies (Cloudflare Web Analytics): token do site em
# dash.cloudflare.com → Web Analytics. Opcional: no Cloudflare Pages também dá para ligar
# no painel, sem código. Deixe vazio para não carregar nada (veja docs/qualidade.md).
PUBLIC_CF_ANALYTICS_TOKEN=

# Site em teste (endereço *.pages.dev, antes da aprovação final): com "true", o site pede aos
# buscadores que não o listem (meta noindex e robots.txt com Disallow). Para lançar, apague esta
# variável no Cloudflare Pages e refaça o build (veja docs/deploy.md).
# BLOQUEAR_BUSCADORES=true
