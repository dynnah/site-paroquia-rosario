# Copie para site/.env (nunca commite o .env).
# As variáveis PUBLIC_ vão para o navegador: não coloque segredo nelas.

# ID e dataset do projeto no Sanity (https://www.sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Opcional: token de leitura, só se o dataset passar a ser privado.
# Fica só no build (sem prefixo PUBLIC_), nunca no navegador.
SANITY_API_READ_TOKEN=

# Liturgia: o texto integral das leituras (tradução CNBB) só pode ser publicado
# com autorização. Mantenha "false" até haver autorização (veja docs/liturgia.md).
# Falso, o site mostra só as referências e o link da Liturgia Diária.
LITURGIA_TEXTO_INTEGRAL=false
